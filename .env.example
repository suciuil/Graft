# Graft — configuration
#
# Graft calls an LLM for concept nodes + per-symbol summaries, so an API key is
# required for the deep pass (`build --deep`). The structural build (`build`,
# `check`, `ask`, `grep`, `map`, traversal) is deterministic tree-sitter and
# needs no key.
#
# Graft is vendor-neutral: GRAFT_PROVIDER picks the WIRE FORMAT, not a company.
# Bring your own key from whichever provider you use.

# --- Provider (required for `build --deep`) -----------------------------------
# Wire format / SDK: "openai" (any OpenAI-compatible endpoint), "anthropic",
# "litellm" (a LiteLLM proxy), "orcarouter" (the OrcaRouter AI gateway), or
# "llm-incubator" (the LLM Incubator gateway). Unset: "llm-incubator" when no
# base URL is configured, else "openai" with an automatic "anthropic" fallback.
# GRAFT_PROVIDER=openai
# Your provider API key. Unset: ANTHROPIC_AUTH_TOKEN is used.
# GRAFT_API_KEY=
# Model id, as your provider names it.
# GRAFT_MODEL=google/gemini-3.8-flash
# Base URL — this is how you pick a provider. Unset: ANTHROPIC_BASE_URL, then
# the LLM Incubator gateway (https://llm-gateway.ve42034x.automotive-wan.com).
# With or without a trailing /v1: the other form is retried automatically. Examples:
#   OpenRouter:  https://openrouter.ai/api/v1
#   Fireworks:   https://api.fireworks.ai/inference/v1
#   Groq:        https://api.groq.com/openai/v1
#   LiteLLM:     http://localhost:4000   (your proxy)
#   Ollama:      http://localhost:11434/v1
# GRAFT_BASE_URL=https://openrouter.ai/api/v1
#
# Native Anthropic (no base URL needed):
#   GRAFT_PROVIDER=anthropic
#   GRAFT_API_KEY=sk-ant-...
#   GRAFT_MODEL=claude-sonnet-5
#
# OrcaRouter AI gateway (OpenAI-compatible, no base URL needed):
#   GRAFT_PROVIDER=orcarouter
#   GRAFT_API_KEY=sk-orca-...
#   GRAFT_MODEL=google/gemini-3.8-flash

# --- Relay balance (a "403 Insufficient account balance") ---------------------
# Balance rejections are retried with backoff: 2s doubling, capped per step.
# GRAFT_BALANCE_RETRY_BASE_MS=2000
# GRAFT_BALANCE_RETRY_MAX_MS=60000
# An EMPTY balance is then waited out: LLM calls pause, one rejected call is
# re-sent per poll interval (a balance rejection costs nothing), and the build
# resumes as soon as the relay accepts it. 0 disables the wait (backoff only).
# GRAFT_BALANCE_WAIT_MS=1800000
# GRAFT_BALANCE_POLL_MS=30000

# --- Deprecated (still honored as a fallback) ---------------------------------
# If GRAFT_API_KEY is unset, these legacy OpenRouter vars are used instead.
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# GRAFT_OPENROUTER_MODEL=google/gemini-3.8-flash
#
# If GRAFT_API_KEY and the OpenRouter fallback are both unset, OrcaRouter's
# vars are honored as a second fallback.
# ORCAROUTER_API_KEY=sk-orca-...
# ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
# ORCAROUTER_MODEL=google/gemini-3.8-flash

# --- Graph location -----------------------------------------------------------
# Where the graph lives (default: <repo>/.context)
# GRAFT_DIR=.context

# --- Build side effects (opt-out) ---------------------------------------------
# GRAFT_NO_GITIGNORE=1  — skip writing graft/ into .gitignore (e.g. you already ignore it globally)
# GRAFT_NO_IGNORE=1     — skip writing .ignore (ripgrep re-admit); only if you manage search yourself

# --- Init (Claude Code) -------------------------------------------------------
# Skip writing statusLine / subagentStatusLine during `graft init` (same as
# `--no-statusline`). Use this when you already have a custom Claude Code
# statusline — a project-level field would hide one in ~/.claude/settings.json.
# GRAFT_NO_STATUSLINE=1

# --- Benchmark (bench/) -------------------------------------------------------
# Per-role model overrides for the benchmark harness.
# BENCH_AGENT_MODEL=anthropic/claude-sonnet-5
# BENCH_JUDGE_MODEL=anthropic/claude-opus-4.8
