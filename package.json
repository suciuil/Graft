{
  "allowScripts": {
    "tree-sitter-go@0.23.4": true,
    "tree-sitter-java@0.23.5": true,
    "tree-sitter-javascript@0.23.1": true,
    "tree-sitter-python@0.21.0": true,
    "tree-sitter-typescript@0.23.2": true,
    "tree-sitter@0.21.1": true
  },
  "bin": {
    "graft": "dist/cli.js"
  },
  "bugs": {
    "url": "https://github.com/NanoNets/context-graph-engine/issues"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "openai": "^6.45.0",
    "tree-sitter": "^0.21.1",
    "tree-sitter-go": "^0.23.4",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-php": "^0.23.4",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-typescript": "^0.23.2",
    "tree-sitter-wasm": "^1.1.4",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver-protocol": "^3.18.2",
    "web-tree-sitter": "^0.25.10"
  },
  "description": "Build a repo's context graph as a folder of linked markdown files: a local, regenerable cache that every query keeps in sync with your code.",
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.1.0",
    "d3-force": "^3.0.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/NanoNets/context-graph-engine#readme",
  "keywords": [
    "ai",
    "agents",
    "knowledge-graph",
    "context",
    "codebase",
    "llm",
    "graft"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "name": "@nanonets/graft",
  "optionalDependencies": {
    "@tree-sitter-grammars/tree-sitter-markdown": "file:../tree-sitter-markdown",
    "@tree-sitter-grammars/tree-sitter-xml": "file:../tree-sitter-xml",
    "@tree-sitter-grammars/tree-sitter-yaml": "file:../tree-sitter-yaml",
    "tree-sitter-c": "file:../tree-sitter-c",
    "tree-sitter-c-sharp": "file:../tree-sitter-c-sharp",
    "tree-sitter-cpp": "file:../tree-sitter-cpp",
    "tree-sitter-css-in-js": "file:../tree-sitter-css-in-js",
    "tree-sitter-csv": "file:../tree-sitter-csv",
    "tree-sitter-groovy": "file:../tree-sitter-groovy",
    "tree-sitter-html": "file:../tree-sitter-html",
    "tree-sitter-json": "file:../tree-sitter-json",
    "tree-sitter-plsql": "file:../tree-sitter-plsql",
    "tree-sitter-razor": "file:../tree-sitter-razor",
    "tree-sitter-scss": "file:../tree-sitter-scss"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NanoNets/context-graph-engine.git"
  },
  "scripts": {
    "build": "npm run build:grammars && npm run build:ts",
    "build:grammars": "node scripts/build-grammars.mjs",
    "build": "tsc -p tsconfig.json && tsc -p viewer/tsconfig.json && node scripts/build-viewer.mjs",
    "cli": "tsx src/cli.ts",
    "dev": "tsc -p tsconfig.json --watch",
    "pack:bundle": "node scripts/pack-bundle.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "prepare": "npm run build && node scripts/stamp-telemetry-key.mjs",
    "prepublishOnly": "npm run build",
    "test": "node scripts/run-tests.mjs"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.12.1"
}
