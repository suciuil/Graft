node_modules/
dist/
*.log

# graft's local graph cache — regenerable, not committed. Each dev runs
# `graft build` locally (it re-adds this line itself), so the folder is a
# personal cache like node_modules, never a shared artifact.
graft/

# Env
.env
.env.local

# OS
.DS_Store

# Session transcripts and prompt traces — local analysis, not product.
transcripts/

# tree-sitter CLI, fetched ad hoc to regenerate a vendored WASM grammar. A ~20MB
# platform-specific binary: keep it out of history, it is not a build input.
tree-sitter
tree-sitter.exe

# Build artifacts of the optional native grammars: vendor/ holds one npm tarball
# per sibling tree-sitter repo, build-bundle/ is the staging tree for the
# self-contained bundle, and the .tgz files are the bundles themselves. All are
# regenerated by `npm run build` / `npm run pack:bundle` from the sibling repos,
# and together they run to tens of MB per rebuild — a cache, not a shared artifact.
vendor/
build-bundle/
*.tgz

# graft's local repository settings — not committed.
/.graft/

# Claude Code settings — regenerated per machine by `graft init`, never shared
# and never part of a PR diff (the hook helpers/skills alongside them stay tracked).
.claude/settings.json
.claude/settings.local.json

# Cursor project config — written per machine by `graft init` (hooks, MCP, rule),
# a personal setup like the Claude settings above, not a shared artifact.
.cursor/

# graft's local repository settings — not committed.
/.graft/
