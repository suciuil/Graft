node_modules/
dist/
*.log

# graft's local graph cache — regenerable, not committed. Each dev runs
# `graft build` locally (it re-adds this line itself), so the folder is a
# personal cache like node_modules, never a shared artifact.
graft/
# Except the graft skill's SKILL.md fixture, which CI checks against the spec.
!test/fixtures/skills/graft/

# Env
.env
.env.local

# OS
.DS_Store

# Session transcripts and prompt traces — local analysis, not product.
transcripts/

# tree-sitter CLI, fetched ad hoc to regenerate a vendored WASM grammar. A ~20MB
# platform-specific binary: keep it out of history, it is not a build input.
tree-sitter
tree-sitter.exe

# Build artifacts of the optional native grammars: build-bundle/ is the staging
# tree for the self-contained bundle; *.tgz are the tarballs themselves. Both are
# regenerated by `npm run build` / `npm run pack:bundle` from the sibling repos.
# vendor/ holds pre-built native .node binaries (kotlin, xml) and is committed so
# consumers don't need to compile tree-sitter grammars from source.
build-bundle/
*.tgz

# Offline Node.js zip(s) next to install-graft.ps1 (node-vX.Y.Z-win-x64.zip, ~37MB):
# a downloaded nodejs.org artifact for the installer, not a build input.
/node-v*-win-x64*.zip

# graft's local repository settings — not committed.
/.graft/

# Claude Code settings — regenerated per machine by `graft init`, never shared
# and never part of a PR diff (the hook helpers/skills alongside them stay tracked).
.claude/settings.json
.claude/settings.local.json

# Cursor project config — written per machine by `graft init` (hooks, MCP, rule),
# a personal setup like the Claude settings above, not a shared artifact.
# Except the fork's no-cloud rule (docs/no-cloud-policy.md), which every
# contributor's Cursor must load.
.cursor/*
!.cursor/rules/
.cursor/rules/*
!.cursor/rules/no-cloud.mdc

# graft's local repository settings — not committed.
/.graft/

# The @trailhq/trail package, laid out by scripts/pack-trail.mjs.
/build/
